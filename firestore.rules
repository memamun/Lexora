rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the current user is an admin
    // Uses a single get() instead of exists() + get() to halve billed reads
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Only allow access to the user's own data subcollections (recursive read is safe)
    match /users/{userId}/{document=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Allow any authenticated user to view UserStats for leaderboards
    match /users/{userId}/UserStats/{docId} {
      allow read: if request.auth != null;
    }

    // User document itself read/write rules
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && (request.auth.uid == userId || isAdmin())
        && request.resource.data.size() < 1048576
        && (
          (!exists(/databases/$(database)/documents/users/$(userId)) && request.resource.data.createdAt == request.time)
          ||
          (exists(/databases/$(database)/documents/users/$(userId)) && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null))
        );
    }

    // WordReview subcollection - additional document size limit (10KB)
    match /users/{userId}/WordReview/{docId} {
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.size() < 10240; // 10KB limit
    }

    // All other collections/subcollections under users/{userId} (1MB limit)
    // We explicitly restrict to known valid subcollections to prevent unbounded storage expansion
    match /users/{userId}/{collectionName}/{docId} {
      allow write: if request.auth != null
        && request.auth.uid == userId
        && (collectionName in ['UserStats', 'LevelProgress', 'QuizAttempt'])
        && request.resource.data.size() < 1048576;
    }

    // Bug reports - authenticated users can create with size limits
    // Rate limit: 1 report per minute per user. Verified via private/bugReportStats
    match /bugReports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.size() < 10240
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          !('createdAt' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          || request.time > get(/databases/$(database)/documents/users/$(request.auth.uid)).data.createdAt + duration.value(24, 'h')
        )
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid)/private/bugReportStats)
            || request.time > get(/databases/$(database)/documents/users/$(request.auth.uid)/private/bugReportStats).data.lastReportTime + duration.value(60, 's'))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/private/bugReportStats).data.lastReportTime == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /users/{userId}/private/bugReportStats {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.data.lastReportTime == request.time;
    }
  }
}
