rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Only allow access to the user's own data subcollections (recursive read is safe)
    match /users/{userId}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    // User document itself write rule
    match /users/{userId} {
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.size() < 1048576;
    }

    // WordReview subcollection - additional document size limit (10KB)
    match /users/{userId}/WordReview/{docId} {
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.size() < 10240; // 10KB limit
    }

    // All other collections/subcollections under users/{userId} (1MB limit)
    // We exclude WordReview to prevent the 10KB limit from being bypassed
    match /users/{userId}/{collectionName}/{docId} {
      allow write: if request.auth != null
        && request.auth.uid == userId
        && !(collectionName in ['WordReview'])
        && request.resource.data.size() < 1048576;
    }

    // Bug reports - authenticated users can create with size limits
    match /bugReports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.size() < 10240
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0;
      allow read, update, delete: if false;
    }
  }
}
